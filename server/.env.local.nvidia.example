# Reed model config — LOCAL on NVIDIA (fully offline, private, zero data egress).
#
# This is the SAME Reed. The models here are NVIDIA's open-weight Nemotron-3 family —
# the exact models used in the cloud submission — served from a GPU in the building
# instead of from Nebius. Because every provider detail is an env var and both ends speak
# the OpenAI-compatible API, NOTHING in Reed's code changes. Copy this to .env and run.
#
# Why this matters: the latency you see on the free cloud tier is the FLOOR (Reed on a
# potato, for free, so it runs anywhere). On a local NVIDIA box it is fast, offline, and
# the child's words and drawings never leave the device. Capability scales with the GPU —
# more VRAM lets you serve a larger Nemotron tier (Nano -> Super), so the better the
# NVIDIA hardware a home or hospital has, the smarter AND faster Reed gets. Same code.

MODEL_PROVIDER=local-nvidia

# --- Serving the open-weight Nemotron models locally ---
# Any OpenAI-compatible server works. Two common ones:
#
#   vLLM (NVIDIA GPU, OpenAI-compatible server on :8000):
#     pip install vllm
#     vllm serve nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B --port 8000
#     # (serve the Super tier on a second port / bigger card for the BRAIN seat)
#
#   Ollama (if an NVIDIA Nemotron build is pulled locally):
#     ollama serve                      # exposes :11434/v1
#
# Point BIG at the largest tier your GPU can hold, FAST at the Nano guard.

BIG_BASE_URL=http://localhost:8000/v1
BIG_API_KEY=local
BIG_MODEL=nvidia/nemotron-3-super-120b-a12b

FAST_BASE_URL=http://localhost:8000/v1
FAST_API_KEY=local
FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Reed's "sight" — the VL model Super calls to see a drawing. Served the same local way.
VISION_MODEL=nvidia/Nemotron-3.5-Super-VL

# Modest GPU? Run the SAME safety architecture at a smaller tier — serve Nano in BOTH
# the BIG and FAST seats. Slower brain, identical guard loop. Reed still works, still safe.
#   BIG_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

PORT=4310
