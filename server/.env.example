# Reed model config. Both Ollama and Nebius Token Factory speak the OpenAI API,
# so switching providers = editing these values, no code change.
# Copy this file to .env and fill in a real key. NEVER commit .env.

# --- SUBMISSION (Nebius Token Factory, NVIDIA Nemotron-3) ---
MODEL_PROVIDER=nebius
BIG_BASE_URL=https://api.studio.nebius.com/v1
BIG_API_KEY=your-nebius-key-here
BIG_MODEL=nvidia/nemotron-3-super-120b-a12b
FAST_BASE_URL=https://api.studio.nebius.com/v1
FAST_API_KEY=your-nebius-key-here
FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# --- DEV (local Ollama) — flip MODEL_PROVIDER to ollama and use these to run fully offline ---
# MODEL_PROVIDER=ollama
# BIG_BASE_URL=http://localhost:11434/v1
# BIG_API_KEY=ollama
# BIG_MODEL=qwen2.5:7b
# FAST_BASE_URL=http://localhost:11434/v1
# FAST_API_KEY=ollama
# FAST_MODEL=qwen2.5:7b   # the guard seat needs a capable model; a dense 3B is too weak

PORT=4310
